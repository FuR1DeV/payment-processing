# Copy to .env to override anything. Everything works without it.

# Secrets (at least 16 characters). docker-compose.yml has dev-only defaults.
# API_KEY=
# WEBHOOK_SECRET=

# Host ports, if the defaults are busy.
# API_PORT=8090
# WEBHOOK_RECEIVER_PORT=8091
# POSTGRES_PORT=5442
# RABBITMQ_UI_PORT=15682

# Swagger UI at /docs (on by default for local runs; switch off anywhere real).
# DOCS_ENABLED=false

# A payment still pending this long after its last event was published gets a fresh event;
# the pause doubles each time, at most this many fresh events per payment.
# STALE_PENDING_AFTER_SECONDS=300
# STALE_PENDING_MAX_REQUEUES=3

# Retries: attempts in total and the first delay (each next one is twice as long).
# MAX_ATTEMPTS=3
# RETRY_BASE_DELAY_SECONDS=2

# Circuit breaker per client host: failures in a row to open it, and how long it stays open.
# WEBHOOK_BREAKER_FAILURES=5
# WEBHOOK_BREAKER_OPEN_SECONDS=30
# After this many postponements the message goes to the DLQ (120 x 30 s = 1 hour).
# WEBHOOK_MAX_POSTPONEMENTS=120

# Gateway emulator.
# GATEWAY_SUCCESS_RATE=0.9
# GATEWAY_MIN_DELAY_SECONDS=2
# GATEWAY_MAX_DELAY_SECONDS=5
